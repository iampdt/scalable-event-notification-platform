DATABASE_URL=postgresql+psycopg://notification_app:local_dev_password@localhost:5433/notifications

# Fernet key used to encrypt webhook signing secrets at rest. This value is for
# local development only; generate a new one for any shared environment with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBHOOK_SECRET_ENCRYPTION_KEY=UtdpRhP4WrBOSC0yYXp2TYAniAUkhyKZF8AhZphjqIQ=
WEBHOOK_TIMEOUT_SECONDS=10
# Allows http:// and private/loopback webhook URLs so a local receiver works.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true

# "fake" logs only; "smtp" sends through SMTP (Mailpit from docker compose locally).
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=notifications@example.test

# Optional. Unset = no cache and no rate limiting; the platform still works.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
RATE_LIMIT_PER_SECOND=50
RATE_LIMIT_BURST=100

# "postgres" = workers poll deliveries with SKIP LOCKED (simplest; default).
# "kafka" = ingestion writes an outbox, app.workers.outbox_relay publishes it,
# app.workers.kafka_consumer consumes it. Run `python -m app.scripts.kafka_topics` once.
DISPATCH_MODE=postgres
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
